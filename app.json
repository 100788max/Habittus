{
  "expo": {
    "name": "HABITTUS",
    "slug": "habittus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "habittus",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "HABITTUS necesita acceder a tus fotos para incorporar imágenes a tus obras.",
          "cameraPermission": "HABITTUS necesita usar la cámara para fotografiar tus obras.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habittus.mobile"
    },
    "android": {
      "package": "com.habittus.mobile"
    }
  }
}
