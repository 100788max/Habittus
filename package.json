{
  "name": "habittus-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:mobile": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "doctor": "expo-doctor",
    "audit:static": "node scripts/static-audit.cjs",
    "test:behavior": "node --test scripts/beta-behavior.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@react-navigation/native": "^7.1.17",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.10",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.13",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "@expo/metro-runtime": "~6.1.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.35.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "^1.17.11",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
